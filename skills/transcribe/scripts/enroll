#!/bin/zsh
# Usage: enroll <recording> <name>
# Saves a voiceprint for <name> from a recording of that person speaking alone
# (30 seconds at least, 60 is better). Transcripts then label that voice with the name.
# Enrolling the same name again replaces the old voiceprint.
source "${0:A:h}/common.sh"
# Use the downloaded models; don't contact Hugging Face while transcribing
export HF_HUB_OFFLINE=1
set -e

if [[ $# -lt 2 ]]; then
  print -u2 "Usage: enroll <recording> <name>"
  exit 1
fi
input="$1"; name="${2:l}"; name="${name// /-}"
[[ -f "$input" ]] || { print -u2 "Not found: $input"; exit 1; }
[[ -x "$PY" ]] || { print -u2 "Setup isn't finished: run setup install first."; exit 1; }

wav="$(mktemp -t enroll).wav"
trap 'rm -f "$wav"' EXIT
print "==> Converting $input"
to_wav "$input" "$wav"
print "==> Building the voiceprint for ${2}"
"$PY" "$SCRIPTS/diarize.py" enroll "$wav" "$VOICES/$name.npy" 2>&1 | grep -vE "Warning|warn\(" || true
[[ -f "$VOICES/$name.npy" ]]
